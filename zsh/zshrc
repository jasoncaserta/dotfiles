# Powerlevel10k instant prompt redirects stdio during startup. Disable it for
# the first Ghostty shell so tmux restore/attach runs with a normal terminal.
if [[ -z "${TMUX:-}" && "${TERM_PROGRAM:-}" = "ghostty" && -z "${NO_AUTO_TMUX:-}" ]]; then
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=off
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Ghostty shell integration for shells launched inside tmux or after shell switches.
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] && [ -r "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration" ]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi

# Command-finish alerts for long-running commands.
autoload -Uz add-zsh-hook
typeset -g _terminal_alert_started_at=0
typeset -g _terminal_alert_command=''
typeset -g TERMINAL_ALERT_MIN_SECONDS=${TERMINAL_ALERT_MIN_SECONDS:-3}

_terminal_alert_preexec() {
  _terminal_alert_started_at=$SECONDS
  _terminal_alert_command=$1
}

_terminal_alert_precmd() {
  if (( _terminal_alert_started_at == 0 )); then
    return 0
  fi

  local runtime=$(( SECONDS - _terminal_alert_started_at ))
  local command_text=${_terminal_alert_command%%$'\n'*}
  local notify_message=${command_text[1,60]:-"Command complete"}
  local tmux_window_id=''

  _terminal_alert_started_at=0
  _terminal_alert_command=''

  (( runtime >= TERMINAL_ALERT_MIN_SECONDS )) || return 0

  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux_window_id=$(tmux display-message -p -t "${TMUX_PANE}" '#{window_id}' 2>/dev/null || printf '')
    notify_message=$(tmux display-message -p -t "${TMUX_PANE}" '#{window_name}' 2>/dev/null || printf '%s' "$notify_message")
  fi

  ("$HOME/.notify.sh" "$notify_message" "done!" "$tmux_window_id") >/dev/null 2>&1 &!
}

_tmux_rename_preexec() {
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    local full_cmd="$1"
    local current_name cmd new_name
    local stripped_cmd="$full_cmd"
    local prefix_token=''
    local preserve_restore_name=0

    current_name=$(tmux display-message -p -t "${TMUX_PANE}" '#{window_name}' 2>/dev/null || printf '')

    while [[ "$stripped_cmd" == [A-Za-z_][A-Za-z0-9_]*=* ]]; do
      prefix_token="${stripped_cmd%% *}"
      [[ "$prefix_token" == TMUX_RESTORE_KEEP_NAME=* ]] && preserve_restore_name=1
      [[ "$prefix_token" == DOTFILES_RESTORE=* ]] && preserve_restore_name=1
      [[ "$stripped_cmd" == *" "* ]] || break
      stripped_cmd="${stripped_cmd#* }"
    done

    if (( preserve_restore_name )); then
      case "$current_name" in
        ''|zsh|bash) ;;
        *) return ;;
      esac
    fi

    cmd="${stripped_cmd%% *}"
    new_name="${cmd:t}"
    [[ -n "$new_name" ]] || return

    tmux rename-window -t "${TMUX_PANE}" "$new_name" 2>/dev/null
  fi
}

_tmux_rename_precmd() {
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux rename-window -t "${TMUX_PANE}" "zsh" 2>/dev/null
  fi
}

_tmux_should_preserve_custom_name() {
  local current_name=''
  [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1 || return 1
  [[ -n "${TMUX_RESTORE_KEEP_NAME:-}${DOTFILES_RESTORE:-}" ]] || return 1
  current_name=$(tmux display-message -p -t "${TMUX_PANE}" '#{window_name}' 2>/dev/null || printf '')
  case "$current_name" in
    ''|zsh|bash)
      return 1
      ;;
  esac
  return 0
}

_tmux_restore_banner() {
  printf '\033[38;5;34m%s\033[0m\n' '──────────────── Restored pane output above; new session starts below ────────────────'
}

_tmux_restore_debug_log() {
  {
    printf '%s\tpane=%s\tpwd=%s\t%s\n' \
      "$(date '+%Y-%m-%d %H:%M:%S')" \
      "${TMUX_PANE:-}" \
      "$PWD" \
      "$*"
  } >> /tmp/tmux-restore-debug.log 2>/dev/null || true
}

_tmux_prepare_restore_agent_launch() {
  local wait_for_client="${1:-0}"
  local print_banner_only="${2:-0}"
  local _sess=''
  local _waited=0

  [[ -n "${TMUX_RESTORE_KEEP_NAME:-}" ]] || return 0

  if (( print_banner_only )); then
    printf '\n'
    _tmux_restore_banner
    printf '\n'
  else
    printf '\n'
    # Clear only the visible viewport so restored output remains available in
    # tmux history while the fresh agent session starts beneath a restore banner.
    printf '\033[0m\033[39m\033[49m\033[2J\033[H'
    _tmux_restore_banner
    printf '\n'
  fi

  if (( wait_for_client )) && [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    _sess=$(tmux display-message -p '#{session_name}' 2>/dev/null || printf 'main')
    until tmux list-clients -t "$_sess" 2>/dev/null | grep -q .; do
      sleep 0.1
      _waited=$(( _waited + 1 ))
      (( _waited >= 100 )) && break
    done
  fi
}

add-zsh-hook preexec _terminal_alert_preexec
add-zsh-hook preexec _tmux_rename_preexec
add-zsh-hook precmd _terminal_alert_precmd
add-zsh-hook precmd _tmux_rename_precmd

claude() {
  local pane="$TMUX_PANE"
  local _dotfiles=''
  if [[ -n "$pane" ]] && command -v tmux >/dev/null 2>&1 && ! _tmux_should_preserve_custom_name; then
    tmux rename-window -t "$pane" "claude" 2>/dev/null
  fi
  if [[ -n "${DOTFILES_RESTORE:-}" ]]; then
    # Clear only the visible viewport so restored history remains in tmux
    # scrollback while the relaunched Claude session starts in a clean pane.
    printf '\033[0m\033[39m\033[49m\033[2J\033[H'
    _dotfiles="$(cat ~/.config/dotfiles/path 2>/dev/null)"
    if [[ -n "$_dotfiles" ]] && command -v python3 >/dev/null 2>&1; then
      command python3 "$_dotfiles/scripts/claude-preserve-scrollback.py" "$@"
      return
    fi
  fi
  command claude "$@"
}

codex() {
  local pane="$TMUX_PANE"
  if [[ -n "$pane" ]] && command -v tmux >/dev/null 2>&1 && ! _tmux_should_preserve_custom_name; then
    tmux rename-window -t "$pane" "codex" 2>/dev/null
  fi
  _tmux_prepare_restore_agent_launch 1
  command codex -c features.codex_hooks=true "$@"
}

_prompt_tmux_restore_picker() {
  setopt local_options no_monitor
  local resurrect_dir="$HOME/.tmux/resurrect"

  # Bail early if another terminal already started the session
  tmux has-session -t main 2>/dev/null && return 1
  command -v fzf >/dev/null 2>&1 || return 1

  # Source _file_age_str from the shared helpers file
  source "${${(%):-%x}:A:h:h}/scripts/_tmux-save-common.sh"

  local -a entries=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" && -f "$resurrect_dir/$line" ]] && \
      entries+=("auto  $(_file_age_str "$resurrect_dir/$line")"$'\t'"$line")
  done < <(cat "$resurrect_dir/last-auto-list" 2>/dev/null)
  while IFS= read -r line; do
    [[ -n "$line" && -f "$resurrect_dir/$line" ]] && \
      entries+=("manual  $(_file_age_str "$resurrect_dir/$line")"$'\t'"$line")
  done < <(cat "$resurrect_dir/last-manual-list" 2>/dev/null)

  # Always include the most recent save (last symlink) at the top if not already listed.
  # Handles the race where kill-server happened before _update_save_list could write the entry.
  local _last_target
  _last_target="$(readlink "$resurrect_dir/last" 2>/dev/null || printf '')"
  if [[ -n "$_last_target" && -f "$resurrect_dir/$_last_target" ]]; then
    local _already_in=0 _e
    for _e in "${entries[@]}"; do
      [[ "${_e##*$'\t'}" == "$_last_target" ]] && { _already_in=1; break; }
    done
    (( _already_in )) || entries=("latest  $(_file_age_str "$resurrect_dir/$_last_target")"$'\t'"$_last_target" "${entries[@]}")
  fi

  (( ${#entries[@]} == 0 )) && return 1
  entries+=("new session"$'\t')

  local selected
  local fzf_sock="${TMPDIR:-/tmp}/tmux-restore-picker.$$.$RANDOM.sock"
  local watcher_pid=
  (
    while true; do
      sleep 0.5
      tmux has-session -t main 2>/dev/null || continue
      [[ -S "$fzf_sock" ]] && curl --unix-socket "$fzf_sock" -sS http -d 'abort' >/dev/null 2>&1
      break
    done
  ) &
  watcher_pid=$!

  selected=$(printf '%s\n' "${entries[@]}" | fzf \
    --prompt='Restore tmux? > ' \
    --height=~$(( ${#entries[@]} + 3 )) \
    --layout=reverse \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-sort \
    --listen="$fzf_sock" \
    2>/dev/null)
  local fzf_status=$?
  kill "$watcher_pid" 2>/dev/null
  wait "$watcher_pid" 2>/dev/null
  rm -f "$fzf_sock"
  (( fzf_status == 0 )) || return 1

  local file
  file=$(printf '%s' "$selected" | cut -d$'\t' -f2)
  [[ -z "$file" ]] && return 1  # "new session" selected

  TMUX_RESTORE_FILE="$resurrect_dir/$file"
  return 0
}

_run_with_spinner() {
  local message="$1"
  shift

  # Write directly to /dev/tty so output is visible even when p10k instant
  # prompt has stdout redirected during zshrc initialisation.
  local _tty
  _tty=$(tty 2>/dev/null) || _tty=/dev/tty

  setopt local_options no_monitor  # suppress job-control notifications for the spinner
  local spinner_pid=''
  (
    local frames=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷')
    local i=1
    while true; do
      printf '\r%s  %s' "${frames[i]}" "$message" >> "$_tty" 2>/dev/null || break
      i=$(( (i % ${#frames[@]}) + 1 ))
      sleep 0.1
    done
  ) &
  spinner_pid=$!

  "$@"
  local cmd_status=$?

  kill "$spinner_pid" 2>/dev/null || true
  wait "$spinner_pid" 2>/dev/null || true
  printf '\r%*s\r' "$(( ${#message} + 3 ))" '' >> "$_tty" 2>/dev/null || true

  if (( cmd_status != 0 )); then
    printf 'error: %s failed (exit %d)\n' "$message" "$cmd_status" >&2
  fi

  return "$cmd_status"
}

