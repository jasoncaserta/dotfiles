# cd + Tab: show eza --icons entries in fzf (requires: brew install fzf)
if command -v fzf >/dev/null 2>&1 && command -v eza >/dev/null 2>&1; then
  _fzf_eza_cd() {
    local typed="${LBUFFER##* }"
    local base="." query="$typed"
    if [[ "$typed" == */* ]]; then
      base="${typed%/*}"
      query="${typed##*/}"
      [[ -z "$base" ]] && base="/"
    fi
    local selected
    selected=$(eza --icons=always --color=always --only-dirs "$base" 2>/dev/null \
      | fzf --ansi --query="$query" --height=50% --layout=reverse 2>/dev/null)
    [[ -z "$selected" ]] && { zle reset-prompt; return; }
    # Strip ANSI codes then the leading icon + space to get the bare name
    local clean
    clean=$(printf '%s' "$selected" \
      | sed $'s/\033\\[[0-9;]*m//g' \
      | sed 's/^[^ ]* //')
    local cmd="${LBUFFER%% *}"
    [[ "$base" == "." ]] \
      && LBUFFER="$cmd $clean" \
      || LBUFFER="$cmd ${base%/}/$clean"
    zle reset-prompt
  }
  zle -N _fzf_eza_cd

  _tab_or_complete() {
    if [[ -n "$POSTDISPLAY" ]]; then
      zle autosuggest-accept
    elif [[ "$LBUFFER" =~ ^(cd|z)[[:space:]] ]]; then
      _fzf_eza_cd
    else
      zle complete-word
    fi
  }
  zle -N _tab_or_complete
  bindkey '^I' _tab_or_complete
fi

# History
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=${HISTSIZE:-100000}
SAVEHIST=${SAVEHIST:-100000}
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# fzf key bindings: Ctrl+R (history), Ctrl+T (file search), Alt+C (cd)
[[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && \
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

# eza as ls with icons by default. Set DOTFILES_USE_NERD_FONT=0 to disable.
if command -v eza >/dev/null 2>&1; then
  if [[ ${DOTFILES_USE_NERD_FONT:-1} == 1 ]]; then
    alias ls='eza --icons'
  else
    alias ls='eza'
  fi
fi

# Autosuggestions from history (requires: brew install zsh-autosuggestions)
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Powerlevel10k prompt
[[ -f /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme ]] && \
  source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Auto-attach Ghostty shells to a persistent tmux session.
if command -v tmux >/dev/null 2>&1; then
  case $- in
    *i*)
      if [ -z "$TMUX" ] && [ "${TERM_PROGRAM:-}" = "ghostty" ] && [ -z "${NO_AUTO_TMUX:-}" ]; then
        _TMUX_DEFAULT_DIR="$HOME/Projects"
        if ! tmux list-sessions >/dev/null 2>&1; then
          local TMUX_RESTORE_FILE=''
          local should_restore=0

          if _prompt_tmux_restore_picker; then
            should_restore=1
          fi

          local _DOTFILES_DIR
          _DOTFILES_DIR="$(cat ~/.config/dotfiles/path 2>/dev/null)"
          if (( should_restore )) && [ -x "$_DOTFILES_DIR/scripts/tmux-restore.sh" ] && [ -n "$TMUX_RESTORE_FILE" ]; then
            _run_with_spinner "Restoring tmux snapshot..." \
              zsh -c '"$1" "$2" </dev/null >/dev/null 2>&1' _ "$_DOTFILES_DIR/scripts/tmux-restore.sh" "$TMUX_RESTORE_FILE"
            # Kill any resurrect spinner still running in the background so it
            # doesn't interfere with the tmux attach that follows.
            # Use SIGKILL to bypass the spinner's SIGTERM trap, which would
            # otherwise call `tmux display-message` without a terminal.
            pkill -9 -f "tmux_spinner" 2>/dev/null || true
            tmux has-session -t main 2>/dev/null || tmux new-session -d -c "$_TMUX_DEFAULT_DIR" -s main 2>/dev/null
            local _attach_wait=0
            until tmux list-panes -t main 2>/dev/null | grep -q .; do
              (( _attach_wait++ >= 20 )) && break
              sleep 0.1
            done
            unset _attach_wait
          elif ! tmux new-session -d -c "$_TMUX_DEFAULT_DIR" -s main 2>/dev/null; then
            local _tmux_wait=0
            while ! tmux has-session -t main 2>/dev/null; do
              (( _tmux_wait++ ))
              if (( _tmux_wait >= 50 )); then
                break
              fi
              sleep 0.1
            done
          fi
        fi
        # Use an explicit attach path after restore so we don't depend on
        # `new-session -A` behavior in the first Ghostty bootstrap shell.
        if tmux has-session -t main 2>/dev/null; then
          tmux attach-session -t main 2>/dev/null && exit 0
        else
          tmux new-session -c "$_TMUX_DEFAULT_DIR" -s main 2>/dev/null && exit 0
        fi
        return
      fi
      ;;
  esac
fi

# Ensure tmux autosave loop is running (fallback if client-attached/session-created hook was missed).
if [[ -n "$TMUX" ]]; then
  _loop_pid_file="/tmp/tmux-autosave-loop.pid"
  if ! { [[ -f "$_loop_pid_file" ]] && kill -0 "$(cat "$_loop_pid_file")" 2>/dev/null; }; then
    _dotfiles_dir=$(cat "$HOME/.config/dotfiles/path" 2>/dev/null)
    # Double-fork so the loop is re-parented to launchd, not the current shell.
    # If it stayed a child here, pgrep -P <pane_pid> would find it alongside
    # codex/claude and save the wrong command in the resurrect file.
    [[ -n "$_dotfiles_dir" && -x "$_dotfiles_dir/scripts/tmux-autosave-loop.sh" ]] && \
      (bash "$_dotfiles_dir/scripts/tmux-autosave-loop.sh" &>/dev/null &)
  fi
  unset _loop_pid_file _dotfiles_dir
fi

# zoxide as cd. Keep this at the end of the shell configuration.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"
