prefix_rule(pattern=["tmux", "list-keys"], decision="allow")
prefix_rule(pattern=["perl", "-0pi", "-e", "s/setw -g window-status-last-format '#\\[bg=colour240,fg=colour255\\]  #I #W  '/setw -g window-status-last-style bg=colour240,fg=colour255/", "~/.tmux.conf"], decision="allow")
prefix_rule(pattern=["tmux", "source-file"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "rg -n \"toggle_quick_terminal|theme =|keybind =\" ~/.config/ghostty ~/Library/Application\\ Support/com.mitchellh.ghostty 2>/dev/null"], decision="allow")
prefix_rule(pattern=["tmux", "show-options"], decision="allow")
prefix_rule(pattern=["tmux", "display-message"], decision="allow")
prefix_rule(pattern=["tmux", "send-keys"], decision="allow")
prefix_rule(pattern=["tmux", "list-panes"], decision="allow")
prefix_rule(pattern=["tmux", "capture-pane"], decision="allow")
prefix_rule(pattern=["sleep", "0.2"], decision="allow")
prefix_rule(pattern=["sleep", "0.3"], decision="allow")
prefix_rule(pattern=["tmux", "list-windows"], decision="allow")
prefix_rule(pattern=["osascript", "-e"], decision="allow")
prefix_rule(pattern=["sleep", "1.5"], decision="allow")
prefix_rule(pattern=["sleep", "0.4"], decision="allow")
prefix_rule(pattern=["tmux", "show-hooks"], decision="allow")
prefix_rule(pattern=["tmux", "show-window-options"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "tmux set-option -wq -t @27 @codex_monitor 1 && tmux set-option -wq -t @27 @codex_background_activity 1 && osascript -e 'display notification \"Codex needs attention\" with title \"Codex\" subtitle \"Ghostty\" sound name \"Glass\"' >/dev/null 2>&1 && tmux set-option -wq -t @27 @needs_attention 1 && tmux set-option -wq -t @27 @codex_background_activity 0 && tmux refresh-client -S && tmux list-windows -a -F '#S:#I id=#{window_id} name=#{window_name} codex_monitor=#{@codex_monitor} codex_bg=#{@codex_background_activity} attention=#{@needs_attention} active=#{window_active}'"], decision="allow")
prefix_rule(pattern=["tmux", "set-option", "-wq", "-t", "@28", "monitor-silence", "1"], decision="allow")
prefix_rule(pattern=["tmux", "set-option", "-wq", "-t", "@28", "@codex_monitor", "1"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "for w in @28 @30; do tmux set-option -wq -t \"$w\" @codex_monitor 1; tmux set-option -wq -t \"$w\" @codex_background_activity 0; tmux set-option -wq -t \"$w\" @needs_attention 0; tmux set-window-option -q -t \"$w\" monitor-silence 3; done && tmux list-windows -a -F '#S:#I id=#{window_id} name=#{window_name} codex_monitor=#{@codex_monitor} codex_bg=#{@codex_background_activity} attention=#{@needs_attention} silence=#{monitor-silence} active=#{window_active}'"], decision="allow")
prefix_rule(pattern=["chmod", "+x", "~/.codex-pane-watch.sh"], decision="allow")
prefix_rule(pattern=["tmux", "set-hook", "-gu", "pane-focus-in"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "\"$HOME/.notify.sh\" \"Codex Test\" \"manual notification check\""], decision="allow")
prefix_rule(pattern=["rm", "-f", "/tmp/codex-pane-watch-events.log", "/tmp/codex-pane-watch.log"], decision="allow")
prefix_rule(pattern=["~/.tmux/plugins/tmux-resurrect/scripts/save.sh"], decision="allow")
prefix_rule(pattern=["bash", "-lc", "source ~/.tmux/plugins/tmux-resurrect/scripts/helpers.sh; printf \"%s\\n%s\\n\" \"$(resurrect_dir)\" \"$(resurrect_file_path)\""], decision="allow")
prefix_rule(pattern=["tmux", "show", "-gv", "status-right"], decision="allow")
prefix_rule(pattern=["tmux", "show", "-gv", "@resurrect-dir"], decision="allow")
prefix_rule(pattern=["tmux", "show", "-gv", "@resurrect-restore-script-path"], decision="allow")
prefix_rule(pattern=["tmux", "show", "-gv", "window-status-format"], decision="allow")
prefix_rule(pattern=["tmux", "show-messages"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "tmux list-sessions 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "TMUX=/private/tmp/tmux-501/codex-plan-test,0,0 tmux -L codex-plan-test start-server; TMUX=/private/tmp/tmux-501/codex-plan-test,0,0 HOME=$HOME /Users/jasoncaserta/Projects/dotfiles/scripts/tmux-restore.sh; tmux -L codex-plan-test list-windows -t main -F '#{window_index}:#{window_name}'"], decision="allow")
prefix_rule(pattern=["cargo", "build"], decision="allow")
prefix_rule(pattern=["git", "fetch", "origin", "main"], decision="allow")
prefix_rule(pattern=["git", "merge", "FETCH_HEAD"], decision="allow")
prefix_rule(pattern=["git", "add", "hammerspoon/init.lua"], decision="allow")
prefix_rule(pattern=["git", "merge", "--ff-only", "FETCH_HEAD"], decision="allow")
prefix_rule(pattern=["git", "push", "-u", "origin"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
