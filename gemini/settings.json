{
  "hooks": {
    "UserPrompt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-option -wu -t \"$TMUX_PANE\" @needs_attention 2>/dev/null; tmux refresh-client -S 2>/dev/null || true"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { printf '\\a'; $HOME/.notify.sh \"Gemini\" \"done!\" \"$TMUX_PANE\"; } || true"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-option -wu -t \"$TMUX_PANE\" @needs_attention 2>/dev/null; tmux refresh-client -S 2>/dev/null || true"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { printf '\\a'; $HOME/.notify.sh \"Gemini\" \"needs attention\" \"$TMUX_PANE\"; } || true"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jasoncaserta/.gemini/hooks/rtk-hook-gemini.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { printf '\\a'; $HOME/.notify.sh \"Gemini\" \"needs approval\" \"$TMUX_PANE\"; } || true"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "pickgpu-devops": {
      "command": "npx",
      "args": [
        "tsx",
        "--env-file=/Users/jasoncaserta/Projects/pickGPU/external-tools/.env",
        "/Users/jasoncaserta/Projects/pickGPU/external-tools/devops-mcp/mcp_server.ts"
      ]
    },
    "pickgpu": {
      "httpUrl": "https://pickgpu.com/mcp"
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  }
}
